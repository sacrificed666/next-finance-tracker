# ==============================================================================
# 🧾 Finance tracker — environment template
# ------------------------------------------------------------------------------
# `make env` copies this file to .env when it is missing. .env is git-ignored:
# put real secrets there, keep this template with safe placeholders only.
# ==============================================================================

# ──────────────────────────────── 🌍 Environment ──────────────────────────────
# development | staging | production — chosen by the Makefile target you run
APP_ENV=development

# Host port the app is published on. Overlays default to 3000 (dev),
# 3001 (staging) and 3000 (production) when this is unset.
APP_PORT=3000

# ──────────────────────────────── 🐘 PostgreSQL ───────────────────────────────
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=finance_tracker

# Host port for the database. Only published in development and staging;
# production keeps Postgres on the internal network.
POSTGRES_PORT=5432

# Connection string used by the app container. Leave it commented out to let
# compose assemble it from the values above (host `db` = the compose service).
# Set it explicitly to point an environment at a managed/external database.
# DATABASE_URL=postgresql://finance:change-me-before-production@db:5432/finance_tracker

# Maximum connections the app keeps in its pool.
DATABASE_POOL_MAX=10

# ──────────────────────────────── 🐳 Docker ───────────────────────────────────
# Image name used when building/pushing (tag is added per environment).
IMAGE_NAME=finance-tracker

# Version tag baked into staging/production images.
IMAGE_TAG=latest
